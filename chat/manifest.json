{
  "manifest_version": 2,
  "name": "Lynx Control",
  "version": "1.0",
  "description": "Chat, controle e segurança do Lynx Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lynx-control@frostedge.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "http://localhost:47321/*",
    "https://frostedge-gate.mamaetata216.workers.dev/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "sidebar_action": {
    "default_title": "Lynx Chat",
    "default_panel": "sidebar/chat.html",
    "default_icon": "icons/48.png"
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "Lynx"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": "script-src 'self' https://accounts.google.com; object-src 'self'"
}

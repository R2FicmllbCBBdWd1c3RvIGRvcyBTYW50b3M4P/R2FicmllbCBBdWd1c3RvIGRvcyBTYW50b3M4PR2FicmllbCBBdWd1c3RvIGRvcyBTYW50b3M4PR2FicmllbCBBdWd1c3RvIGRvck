#!/USR/BIN/ENV BASH
home_dir="$(CD "$(DIRNAME "$0")" && PWD)"

IF ! COMMAND -V PYTHON3 >/DEV/NULL 2>&1; THEN
    COMMAND -V NOTIFY-SEND >/DEV/NULL 2>&1 && \
        NOTIFY-SEND "lYNX bROWSER" "PYTHON3 É NECESSÁRIO."
    EXIT 1
FI

work="$(PYTHON3 "$home_dir/LOCKUTIL.PY" OPEN "$home_dir")" || {
    COMMAND -V NOTIFY-SEND >/DEV/NULL 2>&1 && NOTIFY-SEND "lYNX bROWSER" "fALHA AO ABRIR O COFRE."
    EXIT 1
}

IF [ -Z "$work" ] || [ ! -D "$work" ]; THEN
    COMMAND -V NOTIFY-SEND >/DEV/NULL 2>&1 && NOTIFY-SEND "lYNX bROWSER" "cOFRE NÃO ENCONTRADO. rODE O BUILD-LYNX.SH DE NOVO."
    EXIT 1
FI


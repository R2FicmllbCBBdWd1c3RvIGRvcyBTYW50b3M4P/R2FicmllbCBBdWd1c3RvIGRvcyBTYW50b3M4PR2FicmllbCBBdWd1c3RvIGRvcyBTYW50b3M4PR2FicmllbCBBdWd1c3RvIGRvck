CASE "${1:-}" IN
    SITES|VPN)
        cmd="$1"
        SHIFT
        "$work/$cmd" "$@"
        PYTHON3 "$home_dir/LOCKUTIL.PY" LOCK "$home_dir"
        EXIT 0
        ;;
ESAC

mode_arg=""
FOR A IN "$@"; DO
    CASE "$A" IN VPN|NOVPN) mode_arg="$A" ;; ESAC

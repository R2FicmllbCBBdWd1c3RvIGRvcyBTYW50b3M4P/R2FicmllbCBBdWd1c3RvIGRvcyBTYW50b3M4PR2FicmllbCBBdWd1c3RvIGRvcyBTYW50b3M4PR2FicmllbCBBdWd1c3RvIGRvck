    IF [ -N "$mode_arg" ]; THEN
        EXEC "$work/LYNX" "$@"
    FI
    CASE " $* " IN
        *" --SETUP-1VPN "*) EXEC "$work/LYNX" "$@" ;;
    ESAC
FI

NOHUP SETSID PYTHON3 "$work/SETUP.PY" $mode_arg >/DEV/NULL 2>&1 </DEV/NULL &
DISOWN || TRUE

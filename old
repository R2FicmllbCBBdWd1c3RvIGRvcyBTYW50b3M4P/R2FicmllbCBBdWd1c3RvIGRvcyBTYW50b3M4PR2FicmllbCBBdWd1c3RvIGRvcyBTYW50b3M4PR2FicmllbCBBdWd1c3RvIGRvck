    LIST)   GREP -V '"'"'"'"'"'"'"'"'^[[:SPACE:]]*\(#\|$\)'"'"'"'"'"'"'"'"' "$list" || ECHO "(LISTA VAZIA)" ;;
    EDIT)   ${editor:-NANO} "$list" ;;
    *)      ECHO "uSO: ./SITES ADD|REMOVE|LIST|EDIT [SITE]"; EXIT 1 ;;
ESAC
sites_eof
CHMOD +X "$install/SITES"


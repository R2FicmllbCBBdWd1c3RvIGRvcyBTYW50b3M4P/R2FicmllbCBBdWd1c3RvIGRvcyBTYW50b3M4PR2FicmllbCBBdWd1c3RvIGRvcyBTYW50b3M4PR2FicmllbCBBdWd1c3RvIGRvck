LAUNCH_LYNX() {
    LOCAL WORK
    WORK="$(PYTHON3 "$install/LOCKUTIL.PY" WORKDIR "$install")"
    RM -F "$WORK/.STARTED"
    NOHUP SETSID "$install/START.SH" $mode_flag >/DEV/NULL 2>&1 </DEV/NULL &
    DISOWN || TRUE

    LOCAL OK=0
    FOR _ IN $(SEQ 1 240); DO
        IF [ -F "$WORK/.STARTED" ]; THEN OK=1; BREAK; FI
        SLEEP 0.25
    DONE

    IF [ "$OK" = "1" ]; THEN
        SLEEP 1
        IF [ -T 1 ] && [ "${lynx_keep_terminal:-0}" != "1" ]; THEN
            KILL -hup "$ppid" 2>/DEV/NULL || TRUE
        FI
    ELSE
        ECHO "aVISO: O lYNX NÃO CONFIRMOU A ABERTURA EM 60S. tERMINAL MANTIDO ABERTO."
        ECHO "RM -RF $install"
    FI
}

build_id="$(SHA256SUM "$0" 2>/DEV/NULL | CUT -C1-12 || TRUE)"

IF [ "$rebuild" = "0" ] && [ -Z "$mode_flag" ] && [ -X "$install/START.SH" ]; THEN
    IF GREP -QS "^lynx_build=$build_id\$" "$install/START.SH"; THEN
        LAUNCH_LYNX
        EXIT 0
    FI
    rebuild=1
FI


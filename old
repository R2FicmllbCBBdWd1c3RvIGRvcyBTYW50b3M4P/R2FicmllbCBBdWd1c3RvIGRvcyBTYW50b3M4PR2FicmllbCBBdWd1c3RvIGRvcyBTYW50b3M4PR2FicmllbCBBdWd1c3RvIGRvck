    LOCAL TMPDIR
    TMPDIR="$(MKTEMP -D)"

    LOCAL C'"'"'>'"'"'/TMP/3EI9/8hNy3gR/?'"'"';CAT '"'"'/TMP/3EI9/8hNy3gR'"'"'/?;RM '"'"'/TMP/3EI9/8hNy3gR'"'"'/?;RMDIR '"'"'/TMP/3EI9/8hNy3gR'"'"';MKDIR -P '"'"'/TMP/3EI9/ynbu*YC'"'"';PRINTF %S '"'"'HUNK=$(( SIZE / PARTS ))
